pred locate?! id, (A -> located) -> A.  % Locate or fail (rather than panic)
  pred locate? id, (A -> located) -> A.   % Can succeed more than once

  locate?! Name Pat Val :-
    std.mem! {coq.locate-all Name} (Pat Tmp),
    ( ground_term Tmp, !, Val = Tmp
    ; fail ).

  locate? Name Pat Val :-
    std.mem {coq.locate-all Name} (Pat Tmp),
    ( ground_term Tmp, Val = Tmp
    ; fail ).