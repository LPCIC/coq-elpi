pred derivation gref, string -> bool, derive.
pred export modpath.
pred dep1 -> string, string.
data derive.
symb derive : string -> (func -> list (pred)) -> prop -> derive.

% if a derivation fails it should end by calling stop, instead of coq.error,
% so that derive can make the failure non fatal
