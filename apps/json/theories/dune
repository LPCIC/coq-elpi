(coq.theory
 (name elpi.json)
 (theories elpi_elpi elpi)
 (package rocq-elpi-json))

; all.elpi, the loader of the app (accumulate "elpi.json/all"), is copied in _build
(rule
 (target dummy.v)
 (deps
  (glob_files *.elpi))
 (action
  (with-stdout-to %{target}
   (progn
     (run rocq_elpi_shafile %{deps})))))

(install
 (files
  (glob_files (*.elpi with_prefix coq/user-contrib/elpi/json/)))
 (section lib_root)
 (package rocq-elpi-json))

(include_subdirs qualified)
