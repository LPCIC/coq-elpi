(executable
 (name gen_doc)
 (libraries elpi_plugin))

(rule
 (targets
  coq-builtin.elpi
  coq-builtin-synterp.elpi
  elpi-builtin.elpi)
 (deps gen_doc.exe)
 (mode promote)
 (action (run ./gen_doc.exe)))

(install
 (files
  coq-builtin.elpi
  coq-builtin-synterp.elpi
  elpi-builtin.elpi)
 (section doc)
 (package rocq-elpi))

; also in the findlib directory of rocq-elpi, for an elpi.toml outside
; rocq-elpi: "@rocq-elpi/coq-builtin"
(install
 (files coq-builtin.elpi)
 (section lib)
 (package rocq-elpi))
